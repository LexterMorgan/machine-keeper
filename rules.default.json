{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "npm-cache",
      "title": "npm cache",
      "kind": "command",
      "paths": [".npm/_cacache"],
      "command": ["npm", "cache", "clean", "--force"],
      "risk": "rebuild",
      "reclaim": "Packages are re-downloaded on demand."
    },
    {
      "id": "npx-cache",
      "title": "npx cache",
      "kind": "delete",
      "paths": [".npm/_npx"],
      "risk": "rebuild",
      "reclaim": "One-off CLIs are fetched again on next use."
    },
    {
      "id": "uv-cache",
      "title": "uv cache",
      "kind": "command",
      "paths": [".cache/uv"],
      "command": ["uv", "cache", "clean"],
      "risk": "rebuild",
      "reclaim": "Python wheels are re-downloaded."
    },
    {
      "id": "pip-cache",
      "title": "pip cache",
      "kind": "command",
      "paths": ["Library/Caches/pip"],
      "command": ["python3", "-m", "pip", "cache", "purge"],
      "risk": "rebuild",
      "reclaim": "Python wheels are re-downloaded."
    },
    {
      "id": "pnpm-store",
      "title": "pnpm store",
      "kind": "command",
      "paths": ["Library/pnpm/store"],
      "command": ["pnpm", "store", "prune"],
      "risk": "rebuild",
      "reclaim": "Unreferenced packages are pruned; others re-download."
    },
    {
      "id": "playwright-browsers",
      "title": "Playwright browsers",
      "kind": "delete",
      "paths": ["Library/Caches/ms-playwright"],
      "risk": "rebuild",
      "reclaim": "Run npx playwright install to restore."
    },
    {
      "id": "codex-runtimes",
      "title": "Codex sandbox runtimes",
      "kind": "delete",
      "paths": [".cache/codex-runtimes"],
      "risk": "rebuild",
      "reclaim": "Re-downloaded on the next sandboxed run."
    },
    {
      "id": "xcode-derived-data",
      "title": "Xcode DerivedData",
      "kind": "delete",
      "paths": ["Library/Developer/Xcode/DerivedData"],
      "risk": "rebuild",
      "reclaim": "Next build is slower; nothing is lost."
    },
    {
      "id": "brew-cleanup",
      "title": "Homebrew old versions",
      "kind": "command",
      "paths": ["Library/Caches/Homebrew"],
      "command": ["brew", "cleanup"],
      "risk": "safe",
      "reclaim": "Removes old formula versions and downloads."
    },
    {
      "id": "spotify-cache",
      "title": "Spotify cache",
      "kind": "delete",
      "paths": ["Library/Caches/com.spotify.client"],
      "app": "Spotify",
      "risk": "rebuild",
      "reclaim": "Artwork and audio re-stream. Offline downloads are lost."
    },
    {
      "id": "brave-cache",
      "title": "Brave caches",
      "kind": "delete",
      "paths": [
        "Library/Caches/BraveSoftware",
        "Library/Caches/com.brave.Browser"
      ],
      "app": "Brave Browser",
      "risk": "rebuild",
      "reclaim": "First page loads are slower. Logins and tabs are untouched."
    },
    {
      "id": "chrome-cache",
      "title": "Chrome cache",
      "kind": "delete",
      "paths": ["Library/Caches/Google"],
      "app": "Google Chrome",
      "risk": "rebuild",
      "reclaim": "First page loads are slower. Logins and tabs are untouched."
    },
    {
      "id": "codex-app-cache",
      "title": "Codex app cache",
      "kind": "delete",
      "paths": ["Library/Caches/Codex"],
      "app": "ChatGPT",
      "risk": "rebuild",
      "reclaim": "Regenerated by the ChatGPT app."
    },
    {
      "id": "steam-residue",
      "title": "Steam data (uninstalled app)",
      "kind": "delete",
      "paths": [
        "Library/Application Support/Steam",
        "Library/Caches/Steam"
      ],
      "app": "Steam",
      "optIn": true,
      "risk": "user-files",
      "reclaim": "Only for machines where Steam is no longer installed."
    },
    {
      "id": "cursor-residue",
      "title": "Cursor data (uninstalled app)",
      "kind": "delete",
      "paths": [
        "Library/Application Support/Cursor",
        ".cursor"
      ],
      "optIn": true,
      "risk": "user-files",
      "reclaim": "Only for machines where Cursor is no longer installed. Removes chat history."
    },
    {
      "id": "huggingface-cache",
      "title": "Hugging Face model cache",
      "kind": "delete",
      "paths": [".cache/huggingface"],
      "optIn": true,
      "risk": "user-files",
      "reclaim": "Downloaded models are removed and re-download later."
    },
    {
      "id": "stale-installers",
      "title": "Old installers in Downloads",
      "kind": "installers",
      "paths": ["Downloads"],
      "extensions": [".dmg", ".pkg", ".zip"],
      "days": 30,
      "optIn": true,
      "risk": "user-files",
      "reclaim": "Installer files older than 30 days; re-downloadable."
    }
  ]
}
